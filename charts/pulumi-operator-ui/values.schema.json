{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "hex": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "$ref": "#/definitions/hex" },
        "panel": { "$ref": "#/definitions/hex" },
        "line": { "$ref": "#/definitions/hex" },
        "ink": { "$ref": "#/definitions/hex" },
        "muted": { "$ref": "#/definitions/hex" },
        "focus": { "$ref": "#/definitions/hex" },
        "ok": { "$ref": "#/definitions/hex" },
        "run": { "$ref": "#/definitions/hex" },
        "attention": { "$ref": "#/definitions/hex" },
        "bad": { "$ref": "#/definitions/hex" },
        "neutral": { "$ref": "#/definitions/hex" },
        "okText": { "$ref": "#/definitions/hex" },
        "runText": { "$ref": "#/definitions/hex" },
        "attentionText": { "$ref": "#/definitions/hex" },
        "badText": { "$ref": "#/definitions/hex" },
        "neutralText": { "$ref": "#/definitions/hex" }
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "namespaces": {"type": "array", "items": {"type": "string"}},
    "database": {"type": "object"},
    "oidc": {
      "type": "object",
      "properties": {
        "localLogout": {"type": "boolean"},
        "issuer": {"type": "string"},
        "clientID": {"type": "string"},
        "redirectURL": {"type": "string"}
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "claim": {"type": "string"},
        "allowed": {"type": "array", "items": {"type": "string", "pattern": "^[^,]+$"}}
      }
    },
    "session": {
      "type": "object",
      "properties": {"maxAge": {"type": "string"}}
    },
    "retention": {
      "type": "object",
      "properties": {"runs": {"type": "string"}, "auth": {"type": "string"}}
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "parentRefs": {"type": "array"},
        "hostnames": {"type": "array", "items": {"type": "string"}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "apiServer": {
          "type": "object",
          "properties": {
            "cidrs": {"type": "array", "items": {"type": "string"}},
            "port": {"type": "integer"}
          }
        }
      }
    },
    "displayTimezone": { "type": "string", "minLength": 1 },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light": { "$ref": "#/definitions/palette" },
        "dark": { "$ref": "#/definitions/palette" },
        "brandBar": { "type": "array", "minItems": 5, "maxItems": 5,
          "items": { "$ref": "#/definitions/hex" } }
      }
    },
    "s3History": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string"},
        "region": {"type": "string"},
        "ambientCredentials": {"type": "boolean"},
        "credentialsSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "accessKeyIdKey": {"type": "string"},
            "secretAccessKeyKey": {"type": "string"}
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    }
  }
}
